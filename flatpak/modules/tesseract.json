{
  "name": "tesseract",
  "buildsystem": "autotools",
  "config-opts": [
    "--disable-openmp",
    "--disable-graphics",
    "SVG_SUPPORT=none"
  ],
  "cleanup": [ "/include", "/lib/pkgconfig", "/share/doc", "/share/man" ],
  "sources": [
    {
      "type": "archive",
      "url": "https://github.com/tesseract-ocr/tesseract/archive/refs/tags/5.5.0.tar.gz",
      "sha256": "f2fb34ca035b6d087a42875a35a7a5c4155fa9979c6132365b1e5a28ebc3fc11"
    },
    {
      "type": "shell",
      "commands": [
        "autoreconf -fiv"
      ]
    }
  ]
}
